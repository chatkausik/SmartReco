# Mesh API (required — every LLM/embedding call must go through Mesh)
MESH_API_KEY=rsk_your_key_here
MESH_BASE_URL=https://api.meshapi.ai/v1
MESH_CHAT_MODEL=openai/gpt-4o-mini
MESH_EMBEDDING_MODEL=openai/text-embedding-3-small

# App / sessions
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./smartreco.db
CHROMA_DIR=./chroma_data

# Bootstrap admin (created by scripts/init_db.py if it doesn't exist yet)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password

# Recommendation trigger thresholds
EVENT_THRESHOLD=15
MIN_COOLDOWN_MINUTES=10
MAX_STALENESS_HOURS=24

# Scheduled digest
DIGEST_HOUR=15
DIGEST_MINUTE=0
# Optional: fire the digest job every N minutes instead of waiting for the daily cron slot (demo convenience). Leave blank to disable.
DIGEST_DEV_INTERVAL_MINUTES=

# SMTP (optional — digest emails log to console if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SmartReco <noreply@smartreco.local>

# LangSmith (optional — bonus observability)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=smartreco
